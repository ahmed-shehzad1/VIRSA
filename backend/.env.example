# ---- Server ----
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ---- Supabase ----
# Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
SUPABASE_AVATAR_BUCKET=avatars

# ---- JWT ----
JWT_ACCESS_SECRET=change-this-to-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-to-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=30d

# ---- Password reset / email verification token lifetimes ----
EMAIL_VERIFICATION_EXPIRES_IN_MIN=60
PASSWORD_RESET_EXPIRES_IN_MIN=30

# ---- Account lockout ----
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MIN=15

# ---- SMTP (nodemailer) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Virsa <no-reply@virsa.app>"

FAMILY_INVITE_EXPIRES_IN_MIN=4320
